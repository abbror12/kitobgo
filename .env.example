# ============================================================================
# Kitobgo — environment namunasi.
# Nusxa oling:  cp .env.example .env   (.env git'ga kirmaydi)
#
# Kim o'qiydi:
#   - docker compose  — avtomatik (shu papkadagi .env)
#   - Spring Boot     — .env faylni O'ZI O'QIMAYDI; qiymatlar process env sifatida
#     berilishi kerak:
#       Linux/systemd:  EnvironmentFile=/opt/kitobgo/.env
#       Linux shell:    set -a; source .env; set +a; java -jar kitobgo.jar
#       PowerShell:     Get-Content .env | ? {$_ -match '^\w'} | % { $n,$v = $_ -split '=',2; Set-Item "env:$n" $v }
#
# Production'da SPRING_PROFILES_ACTIVE=prod bilan quyidagilarning BARCHASI majburiy
# (application-prod.yaml'da defaultlar yo'q).
#
# SERVERDA (docker-compose.prod.yaml bilan):
#   DB_URL — mavjud Postgres serveringizga:
#     alohida DB server:        jdbc:postgresql://<db-host>:5432/kitobgo
#     shu serverda (docker'siz): jdbc:postgresql://host.docker.internal:5432/kitobgo
#   S3_ENDPOINT=http://minio:9000                   # konteyner nomi orqali
#   S3_PUBLIC_URL=https://kitobgo.com/files         # nginx /files/ -> minio/kitobgo/
# ============================================================================

SPRING_PROFILES_ACTIVE=prod

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5433/kitobgo
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_POOL_SIZE=10
# DB_CONNECTION_TIMEOUT_MS=3000
# DB_VALIDATION_TIMEOUT_MS=1000
# DB_IDLE_TIMEOUT_MS=600000
# DB_MAX_LIFETIME_MS=1800000

# --- JWT (kamida 32 belgi, tasodifiy; masalan: openssl rand -base64 48) ---
JWT_SECRET=change-me-min-32-chars-random-string
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000

# --- Birinchi super-admin (seed) ---
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=change-me
ADMIN_NAME=Super Admin

# --- Rasm saqlash: MinIO / S3 / R2 ---
STORAGE_TYPE=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kitobgo
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
# CDN yoki ochiq domen; bo'sh qolsa endpoint+bucket ishlatiladi
S3_PUBLIC_URL=

# --- Ixtiyoriy ---
# PORT=8080
# SWAGGER_ENABLED=false
# FCM_SERVICE_ACCOUNT=firebase-service-account.json
# MANAGEMENT_PORT=8081
# APP_TIME_ZONE=Asia/Tashkent
# VIRTUAL_THREADS_ENABLED=false
# PUSH_OUTBOX_BATCH_SIZE=50
# PUSH_OUTBOX_POLL_INTERVAL_MS=1000
# PUSH_OUTBOX_MAX_ATTEMPTS=8
# ORDER_REBALANCE_BATCH_SIZE=100
# GRAFANA_ADMIN_PASSWORD=change-me
# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090
